PORT=3000
NODE_ENV=development

WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WEATHER_MAX_WIND_SPEED=15
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
API_KEY=local-development-api-key

# PostgreSQL container
POSTGRES_DB=equipment_maintenance
POSTGRES_USER=equipment_owner
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Application database connection
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=equipment_maintenance
DB_USER=equipment_app
DB_PASSWORD=

# Database connection pool
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000